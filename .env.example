# Azure Speech Voice Live Configuration
# Copy this file to .env and fill in your values

# ============================================
# Azure Resource Configuration
# ============================================

# Your Azure Speech or Foundry resource name
AZURE_RESOURCE_NAME=your-resource-name

# Azure region where your resource is deployed
# Examples: eastus, westus2, westeurope, southeastasia
AZURE_REGION=eastus

# ============================================
# Authentication (Choose ONE method)
# ============================================

# METHOD 1: API Key (Quick Start - Not recommended for production)
AZURE_SPEECH_API_KEY=your-api-key-here

# METHOD 2: Azure Entra ID (Recommended for production)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ============================================
# Voice Live Configuration
# ============================================

# Default model to use
# Options: gpt-realtime, gpt-4o, gpt-4.1, gpt-5, gpt-realtime-mini, phi4-mm-realtime
DEFAULT_MODEL=gpt-realtime

# Default voice type and name
# Voice types: openai, azure-standard, azure-custom, azure-personal
DEFAULT_VOICE_TYPE=openai
DEFAULT_VOICE_NAME=alloy

# Default language/locale for speech recognition
# Examples: en-US, es-ES, fr-FR, de-DE, ja-JP, zh-CN
DEFAULT_LANGUAGE=en-US

# ============================================
# VAD Configuration
# ============================================

# Voice Activity Detection type
# Options: server_vad, semantic_vad, azure_semantic_vad, azure_semantic_vad_multilingual
DEFAULT_VAD_TYPE=azure_semantic_vad

# VAD threshold (0.0 - 1.0)
VAD_THRESHOLD=0.5

# VAD silence duration in milliseconds
VAD_SILENCE_DURATION_MS=500

# ============================================
# Audio Configuration
# ============================================

# Input audio format
# Options: pcm16, g711_ulaw, g711_alaw
INPUT_AUDIO_FORMAT=pcm16

# Input audio sampling rate
# Options: 8000, 16000, 24000
INPUT_AUDIO_SAMPLING_RATE=24000

# Output audio format
# Options: pcm16, pcm16_8000hz, g711_ulaw, g711_alaw
OUTPUT_AUDIO_FORMAT=pcm16

# ============================================
# Audio Enhancement
# ============================================

# Enable deep noise suppression (true/false)
ENABLE_NOISE_SUPPRESSION=true

# Enable echo cancellation (true/false)
ENABLE_ECHO_CANCELLATION=true

# Remove filler words (true/false)
REMOVE_FILLER_WORDS=false

# ============================================
# Agent Configuration (Optional)
# ============================================

# Use Microsoft Foundry Agent Service
# USE_AGENT_SERVICE=false
# AGENT_ID=your-agent-id
# PROJECT_ID=your-project-id

# ============================================
# Avatar Configuration (Optional)
# ============================================

# Enable avatar video streaming
# ENABLE_AVATAR=false
# AVATAR_CHARACTER=lisa
# AVATAR_VIDEO_WIDTH=1920
# AVATAR_VIDEO_HEIGHT=1080
# AVATAR_BITRATE=2000000

# ============================================
# Advanced Configuration
# ============================================

# Maximum response tokens
MAX_RESPONSE_TOKENS=inf

# Model temperature (0.0 - 1.0)
MODEL_TEMPERATURE=0.8

# Enable input transcription
ENABLE_INPUT_TRANSCRIPTION=true

# Enable audio timestamps
ENABLE_AUDIO_TIMESTAMPS=true

# WebSocket timeout in seconds
WEBSOCKET_TIMEOUT=30

# ============================================
# Development & Debugging
# ============================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable verbose logging
VERBOSE_LOGGING=false

# Save audio streams for debugging
SAVE_AUDIO_DEBUG=false

# ============================================
# Playground Configuration
# ============================================

# Port for the Vite playground
PLAYGROUND_PORT=5173

# Enable playground in production
ENABLE_PLAYGROUND=true
