{
  "type": "azure_semantic_vad_multilingual",
  "description": "Multilingual semantic voice activity detection",
  "useCases": [
    "global-applications",
    "multi-language-support",
    "international-call-centers",
    "multilingual-agents"
  ],
  "supportedLanguages": [
    "en",
    "es",
    "fr",
    "de",
    "it",
    "ja",
    "pt",
    "zh",
    "ko",
    "hi"
  ],
  "configuration": {
    "type": "azure_semantic_vad_multilingual",
    "threshold": 0.5,
    "prefix_padding_ms": 300,
    "silence_duration_ms": 700,
    "remove_filler_words": true,
    "interrupt_response": true,
    "auto_truncate": true,
    "end_of_utterance_detection": {
      "model": "semantic_detection_v1",
      "threshold_level": "default",
      "timeout_ms": 1500
    }
  },
  "languageSpecificSettings": {
    "en": {
      "threshold": 0.5,
      "silence_duration_ms": 700,
      "note": "Standard English settings"
    },
    "es": {
      "threshold": 0.5,
      "silence_duration_ms": 750,
      "note": "Spanish speakers may have longer pauses"
    },
    "fr": {
      "threshold": 0.5,
      "silence_duration_ms": 700,
      "note": "French liaison may affect detection"
    },
    "de": {
      "threshold": 0.5,
      "silence_duration_ms": 700,
      "note": "German compound words work well"
    },
    "ja": {
