# Azure Speech Voice Live Configuration
VITE_AZURE_RESOURCE_NAME=your-resource-name
VITE_AZURE_REGION=eastus
VITE_AZURE_SPEECH_API_KEY=your-api-key-here

# Optional: Azure Entra ID (Recommended for Production)
# VITE_AZURE_TENANT_ID=your-tenant-id
# VITE_AZURE_CLIENT_ID=your-client-id
# VITE_AZURE_CLIENT_SECRET=your-client-secret

# Default Configuration
VITE_DEFAULT_MODEL=gpt-4o
VITE_DEFAULT_VOICE=en-US-Jenny
VITE_DEFAULT_LANGUAGE=en-US

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Audio Settings
VITE_DEFAULT_SAMPLE_RATE=24000
VITE_DEFAULT_AUDIO_FORMAT=pcm16

# VAD Settings
VITE_DEFAULT_VAD_TYPE=azure_semantic_vad
VITE_DEFAULT_VAD_THRESHOLD=0.5
VITE_DEFAULT_SILENCE_DURATION=700
